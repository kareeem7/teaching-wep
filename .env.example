# ===================================================================
#  أسماء المتغيرات فقط — لا تضع أي قيمة حقيقية في هذا الملف.
#  انسخه إلى .env محليًا (وهو مُستبعَد من Git) واملأ قيمك هناك.
# ===================================================================

# عنوان مشروع Supabase (بيئة تطوير/اختبار فقط في هذه المرحلة)
MINHAJ_SUPABASE_URL=

# المفتاح العام (publishable / anon) — آمن للمتصفح ومحمي بـRLS
MINHAJ_SUPABASE_PUBLISHABLE_KEY=

# -------------------------------------------------------------------
# ممنوع تمامًا في أي ملف يُدفع أو يُخدم للمتصفح:
#   service_role key · sb_secret_* · كلمة مرور قاعدة بيانات · JWT secret
# المتصفح لا يحتاجها، ومن يملكها يتجاوز RLS بالكامل.
# -------------------------------------------------------------------

# أصل الموقع في الإنتاج (يُستخدم للروابط المطلقة عند الحاجة فقط)
MINHAJ_PUBLIC_ORIGIN=
