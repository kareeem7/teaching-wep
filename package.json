{
  "name": "minhaj-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منهاج — منصة إدارة المدرّسين والطلاب والامتحانات. واجهة ثابتة + Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "http-server public -a 0.0.0.0 -p 4173 -c-1 --silent",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/assets/css/**/*.css\"",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.0",
    "@supabase/supabase-js": "^2.58.0",
    "bootstrap": "^5.3.8",
    "eslint": "^9.38.0",
    "globals": "^15.15.0",
    "htmlhint": "^1.6.3",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.3",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0"
  }
}
